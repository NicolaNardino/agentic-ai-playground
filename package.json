{
  "name": "strands-agents-experiments",
  "version": "0.1.0",
  "description": "Experiments with AWS Strands Agents and Ollama",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "strands": "tsx --import dotenv/config src/strands-agent.ts",
    "server": "tsx --import dotenv/config src/server.ts",
    "weather:server": "tsx --import dotenv/config src/mcp/weather-server.ts",
    "weather:test": "tsx --import dotenv/config src/weather-test.ts",
    "ui": "cd ui && npm install && npm run dev",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.89.0",
    "@strands-agents/sdk": "^1.0.0-rc.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fastmcp": "^4.0.1",
    "openai": "^6.35.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  }
}
