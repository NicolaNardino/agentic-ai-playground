# AWS credentials (for Strands Agents with Bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Bedrock model (default: us.anthropic.claude-sonnet-4-5)
STRANDS_MODEL_ID=us.anthropic.claude-sonnet-4-5

# Ollama — accessed via Strands' OpenAI-compatible model provider
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Anthropic API (direct, alternative to Bedrock)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL_ID=claude-sonnet-4-6

# Weather Underground (IBM Weather Company) — for MCP weather server and direct test
WU_API_KEY=your-wunderground-api-key
WU_STATION_ID=your-pws-station-id   # e.g. IXXXXX1
WU_MCP_PORT=3003                     # port for the MCP weather server (default: 3003)
